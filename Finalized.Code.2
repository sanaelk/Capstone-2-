# Create prediction function
def predict_match_outcome(home_team, away_team, home_goals, away_goals, date):
    """
    Predict match outcome using trained model
    """
    # Feature engineering
    features = preprocess_features(home_team, away_team, home_goals, away_goals, date)
    
    # Scale features
    features_scaled = scaler.transform([features])
    
    # Make prediction
    prediction = loaded_model.predict(features_scaled)[0]
    probability = loaded_model.predict_proba(features_scaled)[0]
    
    return {
        'predicted_outcome': prediction,
        'probability': dict(zip(loaded_model.classes_, probability)),
        'confidence': max(probability)
    }

